# Copy this file to .env.local (for your own computer) and fill in the values. In Vercel, add the same names under Settings > Environment Variables.
# Never commit the real values. Use the Staging Supabase project for Preview deployments (see docs/STAGING.md).

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# The service-role key bypasses the access rules: server only, never shown in the browser, never in a Preview that points at live data.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Reminders (the scheduled job calls /api/cron/digest with this secret) ---
# Use a long random string. Leave these unset in Preview so a test site can never message the team.
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
# The owner's chat gets the reminders AND the end-of-day close message.
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_STAFF_CHAT_ID=

# --- Shown on the public pages ---
STORE_PHONE=
# Optional: a separate number for the WhatsApp button (digits, with or without +91). Leave empty to use STORE_PHONE. A landline cannot receive WhatsApp,
# so if STORE_PHONE is a landline set this to the shop's WhatsApp mobile number, or the WhatsApp buttons stay hidden.
STORE_WHATSAPP=
# The public web address, used for the sitemap, the canonical link and link previews. Leave empty to use the Vercel production address;
# set it (e.g. https://www.yourdomain.in) once a custom domain is connected.
SITE_URL=

# --- Google reviews carousel on the customer home page (setup notes: docs/CHANGELOG.md, section "Google reviews carousel") ---
# Both are required; if either is empty the reviews section is simply hidden. Server-side only: no NEXT_PUBLIC_ prefix.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# How long the home page may reuse Google's answer, in seconds (default 3600 = one hour). 0 asks Google on every page view: strictest reading of Google's
# no-caching rule, but a slower home page and more billable calls. Never stored in the code or the database either way (see lib/reviews.ts).
REVIEWS_CACHE_SECONDS=

# --- Media (optional, see docs/MEDIA.md) ---
# Serve the eight reel videos from a public Supabase Storage bucket instead of public/reels, e.g. https://YOUR-PROJECT.supabase.co/storage/v1/object/public/reels
# Leave empty to keep using the files in the repository. Baked in at build time: redeploy after changing it.
NEXT_PUBLIC_REELS_VIDEO_BASE_URL=

# --- Bot check on the enquiry form: Cloudflare Turnstile (free). Create a widget at https://dash.cloudflare.com > Turnstile, hostname = your site. ---
# Both keys are needed. Until the SECRET is set the server skips the check (the database limits still apply); until the SITE key is set no widget is shown.
# To try it without a real widget, Cloudflare's test keys: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA (always pass).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Error monitoring: Sentry (free plan is enough). Project > Settings > Client Keys (DSN). Empty = monitoring off. ---
NEXT_PUBLIC_SENTRY_DSN=
# Optional, so errors show real file and line numbers: an auth token with project:releases and org:read, and the names from your Sentry address.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Reminder heartbeat: the address from an outside monitor (for example healthchecks.io). Empty = no heartbeat. See README-fixes-2026-11-25.md ---
# Put {slot} where each reminder's name goes, e.g. https://hc-ping.com/YOUR-PING-KEY/swaasa-{slot}?create=1
HEARTBEAT_URL=

# --- Faster staff sign-in check (optional). 1 = verify the sign-in token locally instead of asking Supabase on every request. Read the trade-off first. ---
AUTH_FAST_CHECK=

