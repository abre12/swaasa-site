# Copy this file to .env.local (for your own computer) and fill in the values. In Vercel, add the same names under Settings > Environment Variables.
# Never commit the real values. Use the Staging Supabase project for Preview deployments (see docs/STAGING.md).

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# The service-role key bypasses the access rules: server only, never shown in the browser, never in a Preview that points at live data.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Reminders (the scheduled job calls /api/cron/digest with this secret) ---
# Use a long random string. Leave these unset in Preview so a test site can never message the team.
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
# The owner's chat gets the reminders AND the end-of-day close message.
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_STAFF_CHAT_ID=

# --- Shown on the public pages ---
STORE_PHONE=
# Optional: a separate number for the WhatsApp button (digits, with or without +91). Leave empty to use STORE_PHONE. A landline cannot receive WhatsApp,
# so if STORE_PHONE is a landline set this to the shop's WhatsApp mobile number, or the WhatsApp buttons stay hidden.
STORE_WHATSAPP=
# The public web address, used for the sitemap, the canonical link and link previews. Leave empty to use the Vercel production address;
# set it (e.g. https://www.yourdomain.in) once a custom domain is connected.
SITE_URL=

# --- Google reviews carousel on the customer home page (see README-reviews.md) ---
# Both are required; if either is empty the reviews section is simply hidden. Server-side only: no NEXT_PUBLIC_ prefix.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
